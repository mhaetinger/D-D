# Opcional: o projeto público do CritCall já acompanha o build.
# Para usar outro projeto, preencher o par completo. Nunca use service_role ou sb_secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# false desliga o login e preserva as fichas locais; não apaga contas ou dados.
VITE_AUTH_ENABLED=true
